const files=JSON.parse(document.getElementById('embedded-files').textContent);
const view=document.getElementById('site');
const cache=new Map();
function bytes(key){const s=atob(files[key].data), b=new Uint8Array(s.length);for(let i=0;i<s.length;i++)b[i]=s.charCodeAt(i);return b;}
function text(key){return new TextDecoder().decode(bytes(key));}
function objectURL(key){if(!cache.has(key))cache.set(key,URL.createObjectURL(new Blob([bytes(key)],{type:files[key].mime})));return cache.get(key);}
function resolve(raw,page){const u=new URL(raw,'https://offline.invalid/'+page);if(u.origin!=='https://offline.invalid')return null;let key=decodeURIComponent(u.pathname.slice(1));if(!key||key.endsWith('/'))key+='index.html';return {key,hash:u.hash};}
function css(source,page){return source.replace(/@import\s+url\([^)]*\)\s*;/g,'').replace(/url\((['"]?)([^)'"\s]+)\1\)/g,(all,q,raw)=>{const r=resolve(raw,page);return r&&files[r.key]?'url("'+objectURL(r.key)+'")':all;});}
function download(key,name){const a=document.createElement('a');a.href=objectURL(key);a.download=name||key.split('/').pop();a.click();}
window.offlineNavigate=function(raw,page,isDownload,name){const r=resolve(raw,page);if(!r||!files[r.key])return false;if(isDownload){download(r.key,name);return true;}if(r.key.endsWith('.html'))show(r.key,r.hash);else window.open(objectURL(r.key),'_blank','noopener');return true;};
function show(page,hash=''){
 const doc=new DOMParser().parseFromString(text(page),'text/html');
 for(const link of doc.querySelectorAll('link[rel="stylesheet"]')){const r=resolve(link.getAttribute('href'),page);if(r&&files[r.key]){const s=doc.createElement('style');s.textContent=css(text(r.key),r.key);link.replaceWith(s);}}
 for(const s of doc.querySelectorAll('style'))s.textContent=css(s.textContent,page);
 for(const e of doc.querySelectorAll('[src]')){const r=resolve(e.getAttribute('src'),page);if(r&&files[r.key]){if(e.tagName==='SCRIPT'){e.removeAttribute('src');e.textContent=text(r.key);}else e.setAttribute('src',objectURL(r.key));}}
 for(const e of doc.querySelectorAll('[style]'))e.setAttribute('style',css(e.getAttribute('style'),page));
 const bridge=doc.createElement('script');bridge.textContent='document.addEventListener("click",function(e){const a=e.target.closest("a[href]");if(!a)return;const raw=a.getAttribute("href");if(raw.startsWith("#"))return;if(parent.offlineNavigate(raw,'+JSON.stringify(page)+',a.hasAttribute("download"),a.getAttribute("download")))e.preventDefault();});'+(hash?'window.addEventListener("load",()=>document.getElementById('+JSON.stringify(decodeURIComponent(hash.slice(1)))+')?.scrollIntoView());':'');
 doc.body.appendChild(bridge);
 view.srcdoc='<!doctype html>'+doc.documentElement.outerHTML;
 document.title=doc.title+' — Offline';
}
show('index.html');
